# =============================================================================
# The Roseland Preparatory School OS - Frontend Environment Template
# =============================================================================

# Canonical Public Website URL (used for SEO metadata, OpenGraph, sitemap, robots.txt)
NEXT_PUBLIC_SITE_URL=https://roselandprep.edu.gh

# API Gateway URL (e.g., http://localhost:8000 for local, or https://roseland-rpsms-backend.onrender.com in production)
# In local development or reverse-proxy setups, leave empty to use relative Next.js API rewrites
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend URL for Next.js SSR / server rewrites (optional, defaults to NEXT_PUBLIC_API_URL or http://127.0.0.1:8000)
BACKEND_URL=http://127.0.0.1:8000

# Dedicated WebSocket Server URL for CBT / Proctoring (optional, derived from NEXT_PUBLIC_API_URL if omitted)
# NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Admissions Application Email Recipient
ADMISSIONS_EMAIL=info@roselandprep.edu.gh

# Optional Email Service Provider (e.g. Resend, SendGrid, Brevo)
# RESEND_API_KEY=re_your_api_key_here
# EMAIL_FROM=Roseland Admissions <admissions@roselandprep.edu.gh>


