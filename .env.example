# =============================================================================
# The Roseland Preparatory School OS - Frontend Environment Template
# =============================================================================

# API Gateway URL (e.g., http://localhost:8000 for local, or https://api.roseland.edu.gh in production)
# In local development or reverse-proxy setups, leave empty to use relative Next.js API rewrites
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend URL for Next.js SSR / server rewrites (optional, defaults to NEXT_PUBLIC_API_URL or http://127.0.0.1:8000)
BACKEND_URL=http://127.0.0.1:8000

# Dedicated WebSocket Server URL for CBT / Proctoring (optional, derived from NEXT_PUBLIC_API_URL if omitted)
# NEXT_PUBLIC_WS_URL=ws://localhost:8000

